# ── База данных ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://profibux:profibux@127.0.0.1:5432/profibux?schema=public"

# ── Telegram ─────────────────────────────────────────────────────────────────
# Токен бота от @BotFather. Используется и для проверки подписи initData.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="profibux_bot"
# Telegram-аккаунт поддержки (без @). Кнопка в профиле открывает этот чат.
SUPPORT_TELEGRAM_USERNAME="profibux_support"
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token на вебхуке
TELEGRAM_WEBHOOK_SECRET=""
# Публичный URL Mini App (нужен для кнопки запуска в боте)
MINIAPP_URL="http://localhost:43117"

# ── Режим разработки ─────────────────────────────────────────────────────────
# Если true, приложение работает без Telegram: подставляется демо-пользователь.
# В продакшене ОБЯЗАТЕЛЬНО false.
DEV_AUTH_BYPASS="true"
DEV_USER_TELEGRAM_ID="777000001"

# ── Сессии ───────────────────────────────────────────────────────────────────
# HMAC-подпись cookie pb_session. В продакшене — случайная строка, не заглушка.
AUTH_SECRET="change-me-to-a-32-byte-random-string"

# ── Redis / очереди (этап 1+) ────────────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ── S3 для пруфов (этап 1+) ──────────────────────────────────────────────────
S3_ENDPOINT="http://127.0.0.1:9000"
S3_REGION="ru-central1"
S3_BUCKET="profibux-proofs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Локально (MinIO) нужен path-style доступ
S3_FORCE_PATH_STYLE="true"

# ── Шифрование реквизитов выплат (AES-256-GCM, 32 байта в hex) ───────────────
PAYOUT_ENCRYPTION_KEY=""

# ── Партнёрские сети ─────────────────────────────────────────────────────────
GETBLOGGER_API_KEY=""
LEADGID_API_KEY=""
RAFINAD_API_KEY=""
# HMAC постбеков. В продакшене без секрета вебхук отвечает 503.
GETBLOGGER_POSTBACK_SECRET=""
LEADGID_POSTBACK_SECRET=""
RAFINAD_POSTBACK_SECRET=""

# ── Крипто-выплаты (этап 3) ──────────────────────────────────────────────────
CRYPTO_PROVIDER="manual"
CRYPTO_PROVIDER_API_KEY=""
CRYPTO_WEBHOOK_SECRET=""
